---
import DefaultLayout from '../layouts/default.astro';
import '../scss/main.scss';
---

<DefaultLayout title="暂不可用">
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="unavailable-screen">
                <h1 class="title-decoration">Kaetram</h1>

                <p>
                    凯特拉姆的 Alpha 测试已经结束，Beta 测试版本将于 2023 年 10 月 7 日开放。如果你想及时了解项目的最新动态，欢迎加入我们的
                    <a target="_blank" href="https://discord.gg/MmbGAaw">Discord 服务器</a>。
                </p>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #unavailable-screen {
        pointer-events: auto;
        opacity: 1;

        p {
            margin-top: 3em;
        }
    }
</style>
